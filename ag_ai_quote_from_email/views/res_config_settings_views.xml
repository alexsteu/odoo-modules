<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ag_ai_quote" model="ir.ui.view">
        <field name="name">res.config.settings.ag.ai.quote</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="ag_ai_quote_setting" string="AI quotation"
                         help="Fill quotations from customer e-mails with Claude or ChatGPT (your own API key)">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="ag_ai_provider" class="col-lg-4 o_light_label"/>
                            <field name="ag_ai_provider"/>
                        </div>
                        <div class="row">
                            <label for="ag_ai_api_key" class="col-lg-4 o_light_label"/>
                            <field name="ag_ai_api_key" password="True"/>
                        </div>
                        <div class="row">
                            <label for="ag_ai_model" class="col-lg-4 o_light_label"/>
                            <field name="ag_ai_model" placeholder="default"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
