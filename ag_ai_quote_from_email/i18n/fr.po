msgstr "La réponse de l'IA est illisible. Veuillez réessayer."

#. module: ag_ai_quote_from_email
#. odoo-python
#: code:addons/ag_ai_quote_from_email/models/sale_order.py:0
msgid "The AI answer is too long and was cut. Try with a shorter e-mail."
msgstr ""
"La réponse de l'IA est trop longue et a été coupée. Essayez avec un e-mail "
"plus court."

#. module: ag_ai_quote_from_email
#. odoo-python
#: code:addons/ag_ai_quote_from_email/wizard/ai_quote_wizard.py:0
