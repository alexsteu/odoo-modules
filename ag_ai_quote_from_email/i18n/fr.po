"The AI could not find who the customer is. Open a quotation for that "
"customer and use the AI button there."
msgstr ""
"L'IA n'a pas trouvé de quel client il s'agit. Ouvrez un devis pour ce client"
" et utilisez-y le bouton « Remplir avec l'IA »."

#. module: ag_ai_quote_from_email
#. odoo-python
#: code:addons/ag_ai_quote_from_email/models/sale_order.py:0
msgid ""
"The AI declined to process this e-mail. Please fill the quotation by hand."
msgstr ""
"L'IA a refusé de traiter cet e-mail. Veuillez remplir le devis à la main."

#. module: ag_ai_quote_from_email
#. odoo-python
#: code:addons/ag_ai_quote_from_email/models/sale_order.py:0
