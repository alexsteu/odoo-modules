<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_minimum_order" model="ir.ui.view">
        <field name="name">res_config_settings_minimum_order</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="sale_minimum_amount_setting" string="Minimum order amount"
                         help="Orders below this untaxed amount cannot be confirmed (0 = no minimum)">
                    <field name="sale_minimum_amount"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
