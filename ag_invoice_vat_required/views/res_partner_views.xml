<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_vat_not_required" model="ir.ui.view">
        <field name="name">res.partner.form.vat.not.required</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="vat_not_required" invisible="not is_company or vat"/>
            </xpath>
        </field>
    </record>
</odoo>
