<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_stale_opportunity" model="ir.ui.view">
        <field name="name">res.config.settings.stale.opportunity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='crm_lead']" position="after">
                <setting id="stale_opportunity_setting" string="Forgotten opportunity reminder"
                         help="Schedule a to-do for the salesperson when an opportunity has no activity and no change">
                    <field name="stale_opportunity_enabled"/>
                    <div class="content-group" invisible="not stale_opportunity_enabled">
                        <div class="mt8">
                            <label for="stale_opportunity_days" string="After"/>
                            <field name="stale_opportunity_days" class="oe_inline"/> days without change
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
