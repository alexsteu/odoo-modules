#. module: ag_ai_vendor_bill
#: model_terms:ir.ui.view,arch_db:ag_ai_vendor_bill.res_config_settings_view_form_ag_ai_bill
msgid ""
"Read supplier invoices (PDF, photo) with Claude or ChatGPT, using your own "
"API key"
msgstr ""
"Lisez les factures de vos fournisseurs (PDF, photo) avec Claude ou ChatGPT, "
"avec votre propre clé API"

#. module: ag_ai_vendor_bill
#: model:ir.actions.server,name:ag_ai_vendor_bill.action_ag_ai_read_bills
#: model_terms:ir.ui.view,arch_db:ag_ai_vendor_bill.view_move_form_ag_ai_bill
msgid "Read with AI"
msgstr "Lire avec l'IA"

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "Select draft vendor bills."
msgstr "Sélectionnez des factures fournisseurs en brouillon."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"Tax ID read on the document: %s. Odoo did not accept it, so it was left "
"empty on the new vendor."
msgstr ""
"Numéro de TVA lu sur le document : %s. Odoo ne l'a pas accepté, il est donc "
"resté vide sur le nouveau fournisseur."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "The AI answer could not be read. Please try again."
msgstr "La réponse de l'IA est illisible. Veuillez réessayer."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"The AI answer is too long and was cut. This document has too many lines for "
"one reading."
msgstr ""
"La réponse de l'IA est trop longue et a été coupée. Ce document a trop de "
"lignes pour une seule lecture."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "The AI declined to read this document. Please fill the bill by hand."
msgstr ""
"L'IA a refusé de lire ce document. Veuillez remplir la facture à la main."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"The AI provider is limiting your account (too many requests or no credit "
"left). Try again in a minute or check your account with the provider."
msgstr ""
"Le fournisseur d'IA limite votre compte (trop de demandes ou crédit épuisé)."
" Réessayez dans une minute ou vérifiez votre compte chez le fournisseur."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"The AI provider refused your API key. Check it in Invoicing (or Accounting) "
"> Configuration > Settings > AI bill reader."
msgstr ""
"Le fournisseur d'IA a refusé votre clé API. Vérifiez-la dans Facturation (ou"
" Comptabilité) > Configuration > Paramètres > Lecture des factures par IA."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "The AI service did not answer in time. Please try again."
msgstr "Le service d'IA n'a pas répondu à temps. Veuillez réessayer."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "The AI service did not answer: %s"
msgstr "Le service d'IA n'a pas répondu : %s"

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"The AI service is temporarily overloaded. Please try again in a minute."
msgstr ""
"Le service d'IA est momentanément surchargé. Veuillez réessayer dans une "
"minute."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"The document is in %(currency)s, a currency that is not active in Odoo: the "
"bill stays in %(kept)s."
msgstr ""
"Le document est en %(currency)s, une devise qui n'est pas active dans Odoo :"
" la facture reste en %(kept)s."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"Warning: total on the document %(doc)s, total in Odoo %(odoo)s (check the "
"taxes)."
msgstr ""
"Attention : total sur le document %(doc)s, total dans Odoo %(odoo)s "
"(vérifiez les taxes)."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "connection error"
msgstr "erreur de connexion"

#. module: ag_ai_vendor_bill
#: model_terms:ir.ui.view,arch_db:ag_ai_vendor_bill.res_config_settings_view_form_ag_ai_bill
msgid "default"
msgstr "par défaut"

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"no PDF or image attached. Attach the supplier invoice to the bill, then try "
"again."
msgstr ""
"aucun PDF ni image en pièce jointe. Joignez la facture du fournisseur, puis "
"réessayez."
