#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid ""
"Add your AI API key in Invoicing (or Accounting) > Configuration > Settings "
"> AI bill reader."
msgstr ""
"Ajoutez votre clé API dans Facturation (ou Comptabilité) > Configuration > "
"Paramètres > Lecture des factures par IA."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "Bill filled by AI from %s. Please check it before posting."
msgstr ""
"Facture remplie par l'IA à partir de %s. Vérifiez-la avant de la "
"comptabiliser."

#. module: ag_ai_vendor_bill
#: model:ir.model.fields,field_description:ag_ai_vendor_bill.field_res_config_settings__ag_ai_bill_api_key
msgid "Bill reader: AI API key"
msgstr "Lecture des factures : clé API de l'IA"

#. module: ag_ai_vendor_bill
#: model:ir.model.fields,field_description:ag_ai_vendor_bill.field_res_config_settings__ag_ai_bill_model
