msgstr "Claude (Anthropic)"

#. module: ag_ai_vendor_bill
#: model:ir.model.fields,help:ag_ai_vendor_bill.field_res_config_settings__ag_ai_bill_api_key
msgid ""
"Key of your own account with the AI provider. Leave empty to use the key "
"entered for AI quotations, when that module is installed."
msgstr ""
"Clé de votre propre compte chez le fournisseur d'IA. Laissez vide pour "
"utiliser la clé saisie pour les devis par IA, si ce module est installé."

#. module: ag_ai_vendor_bill
#: model:ir.model.fields,help:ag_ai_vendor_bill.field_res_config_settings__ag_ai_bill_model
msgid ""
"Leave empty for the default: claude-sonnet-5-5 (Claude) or gpt-4o (ChatGPT)."
msgstr ""
"Laissez vide pour le modèle par défaut : claude-sonnet-5-5 (Claude) ou "
"gpt-4o (ChatGPT)."

#. module: ag_ai_vendor_bill
#. odoo-python
#: code:addons/ag_ai_vendor_bill/models/account_move.py:0
msgid "No line could be read on the document."
msgstr "Aucune ligne n'a pu être lue sur le document."

