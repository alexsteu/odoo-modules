<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ag_ai_bill" model="ir.ui.view">
        <field name="name">account.move.form.ag.ai.bill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ag_ai_read_bill" type="object" string="Read with AI"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund')"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
