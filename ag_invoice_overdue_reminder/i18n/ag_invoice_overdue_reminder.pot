#. module: ag_invoice_overdue_reminder
#: model:mail.template,body_html:ag_invoice_overdue_reminder.mail_template_overdue_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello<t t-if=\"not object.partner_id.is_company\"> <t t-out=\"object.partner_id.name or ''\"/></t>,</p>\n"
"    <p>Unless we missed your payment, invoice <strong t-out=\"object.name or ''\"/>\n"
"        was due on <t t-out=\"format_date(object.invoice_date_due) or ''\"/>.\n"
"        The amount still open is <strong t-out=\"format_amount(object.amount_residual, object.currency_id) or ''\"/>.</p>\n"
"    <p>You can view and pay it online here:</p>\n"
"    <p><a t-att-href=\"object.get_portal_url()\" style=\"background-color:#875A7B;padding:8px 16px;color:#fff;border-radius:5px;text-decoration:none;\">View the invoice</a></p>\n"
"    <p>If you already paid, please ignore this message. Thank you!</p>\n"
"    <p>Best regards,<br/><t t-out=\"object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""

