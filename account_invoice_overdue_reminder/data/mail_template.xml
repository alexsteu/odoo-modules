<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_overdue_reminder" model="mail.template">
        <field name="name">Invoicing: overdue invoice reminder</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">{{ object.company_id.name }} - reminder for invoice {{ object.name }}</field>
        <field name="email_from">{{ (object.invoice_user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
    <p>Unless we missed your payment, invoice <strong t-out="object.name or ''"/>
        was due on <t t-out="format_date(object.invoice_date_due) or ''"/>.
        The amount still open is <strong t-out="format_amount(object.amount_residual, object.currency_id) or ''"/>.</p>
    <p>You can view and pay it online here:</p>
    <p><a t-att-href="object.get_portal_url()" style="background-color:#875A7B;padding:8px 16px;color:#fff;border-radius:5px;text-decoration:none;">View the invoice</a></p>
    <p>If you already paid, please ignore this message. Thank you!</p>
    <p>Best regards,<br/><t t-out="object.company_id.name or ''"/></p>
</div>
        </field>
    </record>
</odoo>
