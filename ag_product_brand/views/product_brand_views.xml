<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_brand_view_list" model="ir.ui.view">
        <field name="name">product.brand.list</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_count"/>
            </tree>
        </field>
    </record>
    <record id="product_brand_view_form" model="ir.ui.view">
        <field name="name">product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Brand name"/></h1>
                    </div>
                    <field name="description" placeholder="Description"/>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_brand_action" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_product_brand" name="Brands" action="product_brand_action"
              parent="sale.prod_config_main" sequence="5"/>
    <record id="product_template_form_view_brand" model="ir.ui.view">
        <field name="name">product.template.form.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="product_brand_id"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_search_view_brand" model="ir.ui.view">
        <field name="name">product.template.search.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="product_brand_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Brand" name="groupby_brand" context="{'group_by': 'product_brand_id'}"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_tree_view_brand" model="ir.ui.view">
        <field name="name">product.template.list.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="product_brand_id" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="sale_report_search_brand" model="ir.ui.view">
        <field name="name">sale.report.search.brand</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Brand" name="groupby_brand" context="{'group_by': 'product_brand_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
