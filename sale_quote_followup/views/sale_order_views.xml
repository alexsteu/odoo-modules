<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_quote_followup" model="ir.ui.view">
        <field name="name">sale.order.form.quote.followup</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//group[@name='sale_info']" position="inside">
                <field name="followup_stop"/>
                <field name="followup_count"/>
                <field name="followup_last_date"/>
            </xpath>
        </field>
    </record>
</odoo>
