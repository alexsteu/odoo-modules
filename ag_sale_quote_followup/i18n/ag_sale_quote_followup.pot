#. module: ag_sale_quote_followup
#: model:mail.template,body_html:ag_sale_quote_followup.mail_template_quote_followup
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello<t t-if=\"not object.partner_id.is_company\"> <t t-out=\"object.partner_id.name or ''\"/></t>,</p>\n"
"    <p>I am coming back to you about quotation <strong t-out=\"object.name or ''\"/>\n"
"        (<t t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/>).</p>\n"
"    <p>Do you have any question, or would you like me to adjust something?\n"
"        You can review and sign it online here:</p>\n"
"    <p><a t-att-href=\"object.get_portal_url()\" style=\"background-color:#875A7B;padding:8px 16px;color:#fff;border-radius:5px;text-decoration:none;\">View the quotation</a></p>\n"
"    <p>Best regards,<br/><t t-out=\"object.user_id.name or object.company_id.name or ''\"/></p>\n"
"</div>\n"
"        "
msgstr ""

