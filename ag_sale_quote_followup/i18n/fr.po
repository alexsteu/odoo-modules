#. module: ag_sale_quote_followup
#: model:mail.template,body_html:ag_sale_quote_followup.mail_template_quote_followup
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello<t t-if=\"not object.partner_id.is_company\"> <t t-out=\"object.partner_id.name or ''\"></t></t>,</p>\n"
"    <p>I am coming back to you about quotation <strong t-out=\"object.name or ''\"></strong>\n"
"        (<t t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"></t>).</p>\n"
"    <p>Do you have any question, or would you like me to adjust something?\n"
"        You can review and sign it online here:</p>\n"
"    <p><a t-att-href=\"object.get_portal_url()\" style=\"background-color:#875A7B;padding:8px 16px;color:#fff;border-radius:5px;text-decoration:none;\">View the quotation</a></p>\n"
"    <p>Best regards,<br><t t-out=\"object.user_id.name or object.company_id.name or ''\"></t></p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Bonjour<t t-if=\"not object.partner_id.is_company\"> <t t-out=\"object.partner_id.name or ''\"></t></t>,</p>\n"
"    <p>Je reviens vers vous au sujet du devis <strong t-out=\"object.name or ''\"></strong>\n"
"        (<t t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"></t>).</p>\n"
"    <p>Avez-vous des questions, ou souhaitez-vous que j'adapte quelque chose ?\n"
"        Vous pouvez le consulter et le signer en ligne ici :</p>\n"
"    <p><a t-att-href=\"object.get_portal_url()\" style=\"background-color:#875A7B;padding:8px 16px;color:#fff;border-radius:5px;text-decoration:none;\">Voir le devis</a></p>\n"
"    <p>Cordialement,<br><t t-out=\"object.user_id.name or object.company_id.name or ''\"></t></p>\n"
"</div>\n"
"        "

#. module: ag_sale_quote_followup
#: model_terms:ir.ui.view,arch_db:ag_sale_quote_followup.res_config_settings_view_form_quote_followup
msgid "After"
msgstr "Après"

#. module: ag_sale_quote_followup
#: model:ir.model.fields,field_description:ag_sale_quote_followup.field_res_company__quote_followup_enabled
#: model:ir.model.fields,field_description:ag_sale_quote_followup.field_res_config_settings__quote_followup_enabled
#: model_terms:ir.ui.view,arch_db:ag_sale_quote_followup.res_config_settings_view_form_quote_followup
msgid "Automatic quotation follow-up"
msgstr "Relance automatique des devis"

#. module: ag_sale_quote_followup
#: model:ir.model.fields,help:ag_sale_quote_followup.field_sale_order__followup_next_date
msgid ""
"Day the next reminder will be e-mailed to the customer. Empty when none is "
"planned: quotation not sent, follow-up stopped, maximum reached, quotation "
"expired, customer without e-mail, or customer who already answered."
msgstr ""
"Date d'envoi de la prochaine relance au client. Vide quand aucune n'est "
"prévue : devis non envoyé, relances arrêtées, maximum atteint, devis expiré,"
" client sans e-mail ou client qui a déjà répondu."

#. module: ag_sale_quote_followup
#: model_terms:ir.ui.view,arch_db:ag_sale_quote_followup.res_config_settings_view_form_quote_followup
msgid "E-mail customers who did not answer a sent quotation"
msgstr "Envoyez un e-mail aux clients qui n'ont pas répondu à un devis envoyé"

#. module: ag_sale_quote_followup
#: model:ir.model.fields,field_description:ag_sale_quote_followup.field_res_company__quote_followup_start_date
#: model:ir.model.fields,field_description:ag_sale_quote_followup.field_res_config_settings__quote_followup_start_date
msgid "Follow up quotations sent since"
msgstr "Relancer les devis envoyés depuis le"

#. module: ag_sale_quote_followup
#: model:ir.model.fields,field_description:ag_sale_quote_followup.field_res_company__quote_followup_days
#: model:ir.model.fields,field_description:ag_sale_quote_followup.field_res_config_settings__quote_followup_days
msgid "Follow-up after (days)"
msgstr "Relance après (jours)"

