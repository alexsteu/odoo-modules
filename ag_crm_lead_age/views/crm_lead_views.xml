<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_case_tree_view_oppor_age" model="ir.ui.view">
        <field name="name">crm_case_tree_view_oppor_age</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="age_days" optional="show" decoration-warning="age_days &gt; 30"/>
            </xpath>
        </field>
    </record>
</odoo>
